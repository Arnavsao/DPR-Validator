# Root gitignore for DPR Validator project

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
# Un-ignore the frontend src/lib/ directory (caught by bare lib/ pattern above)
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyc

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
ENV/
env/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/

# ── Environments & Sensitive Files ────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
backend/.env

# ── SQLite / Database / Uploads ───────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite3
backend/storage/uploads/
backend/storage/*.db
backend/storage/*.db-shm
backend/storage/*.db-wal

# ── ChromaDB Persistence ─────────────────────────────────────────────────────
backend/storage/chroma_db/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Linux ─────────────────────────────────────────────────────────────────────
*~

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.settings/
*.code-workspace

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# ── Testing / Coverage ────────────────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
/coverage

# ── Distribution / Packaging ─────────────────────────────────────────────────
*.tar.gz
*.whl

# ── Large / Binary Files ─────────────────────────────────────────────────────
*.pdf

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pem
.agents/
CLAUDE.md
AGENTS.md
