# Root gitignore for DPR Validator project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
# Un-ignore the frontend src/lib/ directory (was caught by the bare lib/ pattern above)
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/

# Node (in case package.json is at root, but node_modules is ignored in frontend/ node_modules is already ignored there)
node_modules/

# Environments & sensitive files
.env
.env.*
!.env.example
*.env

# SQLite / Database / Uploads
*.db
*.sqlite3
backend/storage/uploads/
backend/storage/*.db

# macOS files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# IDEs
.idea/
.vscode/
*.swp
*.swo
