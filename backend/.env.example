# DPR Validator — Backend Environment Configuration
# Copy this file to .env and fill in your values

DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./storage/dpr_validator.db
MAX_UPLOAD_SIZE_MB=150

# ── RAG / Ollama ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model (must be pulled: ollama pull mxbai-embed-large)
EMBED_MODEL=mxbai-embed-large

# Primary LLM validator — set to your model tag from: ollama list
LLM_PRIMARY=qwen3:8b
LLM_FALLBACK_1=gemma3:12b
LLM_FALLBACK_2=gemma3:4b

# (Optional) Gemini API Fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Retrieval
RAG_TOP_K=5
LLM_TIMEOUT_SECS=600

# Chunking
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200
